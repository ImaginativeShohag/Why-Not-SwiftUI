    "accessibility_differentiate_without_color_example_title" : {
      "comment" : "Title for a section demonstrating the 'Differentiate Without Color' accessibility preference. It explains the purpose of the example UI elements below it. Appears on the Accessibility Preferences screen.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مثال إمكانية الوصول: التمييز بدون لون"
