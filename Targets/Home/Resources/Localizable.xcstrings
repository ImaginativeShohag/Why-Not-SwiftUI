    "canvas_device_settings_effects_text": {
      "comment": "Text explaining that adjusting 'Canvas Device Settings' helps understand Dynamic Type effects. Appears on the Dynamic Type demonstration screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **Canvas Device Settings** to quickly understand the effects."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **ক্যানভাস ডিভাইস সেটিংস** থেকে দ্রুত প্রভাবগুলি বুঝতে পারবেন।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **キャンバスデバイス設定** から効果を素早く理解できます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **Canvas-Geräteeinstellungen** , um die Effekte schnell zu verstehen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **Paramètres de l'appareil Canvas** pour comprendre rapidement les effets."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **कैनवास डिवाइस सेटिंग्स** से प्रभावों को तुरंत समझने के लिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **Impostazioni dispositivo Canvas** per comprendere rapidamente gli effetti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **Ajustes del Dispositivo Canvas** para comprender rápidamente los efectos."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **Canvas Device Settings** för att snabbt förstå effekterna."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **إعدادات جهاز اللوحة** لفهم التأثيرات بسرعة."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **画布设备设置** 以快速了解效果。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **캔버스 장치 설정** 에서 효과를 빠르게 이해할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **Canvas Apparaatinstellingen** om de effecten snel te begrijpen."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **การตั้งค่าอุปกรณ์ Canvas** เพื่อทำความเข้าใจผลกระทบได้อย่างรวดเร็ว"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **Tetapan Peranti Kanvas** untuk memahami kesan dengan cepat."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **Configurações do Dispositivo Canvas** para entender rapidamente os efeitos."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": " **Tuval Cihaz Ayarları** 'ndan etkileri hızlıca anlamak için."
