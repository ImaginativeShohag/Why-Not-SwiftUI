    "accessibility_hint_double_tap_increase_text_size" : {
      "comment" : "Accessibility Hint: This string is a hint for accessibility tools (like VoiceOver) on the Accessibility Preferences Screen. It describes the action that occurs when a user double-taps on the 'Hello, World!' text, which is to increase its size. It helps users understand the interactive behavior of the element.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "انقر مرتين لزيادة حجم النص."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "টেক্সটের আকার বাড়াতে ডাবল ট্যাপ করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Doppeltippen, um die Textgröße zu erhöhen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Double tap to increase the text size."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toca dos veces para aumentar el tamaño del texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touchez deux fois pour augmenter la taille du texte."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "टेक्स्ट का आकार बढ़ाने के लिए दो बार टैप करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tocca due volte per aumentare la dimensione del testo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "テキストサイズを大きくするにはダブルタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "텍스트 크기를 늘리려면 두 번 탭하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ketik dua kali untuk membesarkan saiz teks."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dubbeltikken om de tekstgrootte te vergroten."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Toque duas vezes para aumentar o tamanho do texto."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dubbeltryck för att öka textstorleken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "แตะสองครั้งเพื่อเพิ่มขนาดข้อความ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Metin boyutunu artırmak için iki kez dokunun."
