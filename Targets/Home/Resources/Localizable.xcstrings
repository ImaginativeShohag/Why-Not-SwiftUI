    "app_storage_description_text" : {
      "comment" : "Text label. Explains that this screen demonstrates the use of @AppStorage and that values are sourced from UserDefaults. Appears on the App Storage Example screen.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعرض هذه الشاشة مثالاً على `@AppStorage`. جميع القيم هنا تأتي من `UserDefaults` باستخدام `@AppStorage`."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই স্ক্রিনটি `@AppStorage`-এর উদাহরণ প্রদর্শন করে। এখানে সমস্ত মান `@AppStorage` ব্যবহার করে `UserDefaults` থেকে আসছে।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Bildschirm demonstriert ein Beispiel für `@AppStorage`. Alle Werte hier stammen aus `UserDefaults` unter Verwendung von `@AppStorage`."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "This screen demonstrate example for `@AppStorage`. All the value here are coming form `UserDefaults` using `@AppStorage`."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta pantalla demuestra un ejemplo de `@AppStorage`. Todos los valores aquí provienen de `UserDefaults` usando `@AppStorage`."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cet écran démontre un exemple de `@AppStorage`. Toutes les valeurs ici proviennent de `UserDefaults` en utilisant `@AppStorage`."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "यह स्क्रीन `@AppStorage` का उदाहरण प्रदर्शित करती है। यहां सभी मान `@AppStorage` का उपयोग करके `UserDefaults` से आ रहे हैं।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Questa schermata dimostra un esempio di `@AppStorage`. Tutti i valori qui provengono da `UserDefaults` usando `@AppStorage`."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "この画面は`@AppStorage`の例を示しています。ここにあるすべての値は、`@AppStorage`を使用して`UserDefaults`から来ています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "이 화면은 `@AppStorage`의 예시를 보여줍니다. 여기의 모든 값은 `@AppStorage`를 사용하여 `UserDefaults`에서 가져옵니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Skrin ini menunjukkan contoh untuk `@AppStorage`. Semua nilai di sini datang dari `UserDefaults` menggunakan `@AppStorage`."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dit scherm demonstreert een voorbeeld van `@AppStorage`. Alle waarden hier komen uit `UserDefaults` met behulp van `@AppStorage`."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta tela demonstra um exemplo de `@AppStorage`. Todos os valores aqui vêm de `UserDefaults` usando `@AppStorage`."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Denna skärm demonstrerar ett exempel på `@AppStorage`. Alla värden här kommer från `UserDefaults` med hjälp av `@AppStorage`."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "หน้าจอนี้แสดงตัวอย่างสำหรับ `@AppStorage` ค่าทั้งหมดที่นี่มาจาก `UserDefaults` โดยใช้ `@AppStorage`"
          }
