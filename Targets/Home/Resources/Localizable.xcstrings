            "value" : "Verwenden Sie **VoiceOver**, um die folgenden Beispiele zu überprüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use **VoiceOver** to check below examples."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa **VoiceOver** para revisar los ejemplos a continuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez **VoiceOver** pour vérifier les exemples ci-dessous."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "नीचे दिए गए उदाहरणों की जाँच करने के लिए **वॉयसओवर** का उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
