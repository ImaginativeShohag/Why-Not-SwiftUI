    "accessibility_ignored_element_explanation": {
      "comment": "Text label explaining the effect of `accessibilityHidden(true)` on a UI element. It clarifies that the element will be ignored by accessibility tools. This appears on the 'General Accessibility Modifiers' screen, within the 'Ignored Element Example' section.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This element will be hidden to AX tools. So it will be ignored by AX tools."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই উপাদানটি AX টুলস থেকে লুকানো থাকবে। তাই এটি AX টুলস দ্বারা উপেক্ষা করা হবে।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この要素はAXツールから隠されます。そのため、AXツールによって無視されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Element wird vor AX-Tools verborgen. Daher wird es von AX-Tools ignoriert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet élément sera masqué pour les outils d'accessibilité (AX). Il sera donc ignoré par les outils d'accessibilité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह तत्व AX टूल से छिपा रहेगा। इसलिए इसे AX टूल द्वारा अनदेखा कर दिया जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo elemento sarà nascosto agli strumenti AX. Quindi verrà ignorato dagli strumenti AX."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este elemento estará oculto para las herramientas de accesibilidad (AX). Por lo tanto, será ignorado por las herramientas de accesibilidad."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Detta element kommer att döljas för AX-verktyg. Därför kommer det att ignoreras av AX-verktyg."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيتم إخفاء هذا العنصر عن أدوات AX. لذلك سيتم تجاهله بواسطة أدوات AX."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此元素将对辅助功能工具（AX tools）隐藏。因此，它将被辅助功能工具忽略。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 요소는 AX 도구에 숨겨집니다. 따라서 AX 도구에 의해 무시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit element wordt verborgen voor AX-tools. Het zal daarom worden genegeerd door AX-tools."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "องค์ประกอบนี้จะถูกซ่อนจากเครื่องมือ AX ดังนั้นเครื่องมือ AX จะละเว้นมัน"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elemen ini akan disembunyikan daripada alat AX. Oleh itu, ia akan diabaikan oleh alat AX."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este elemento ficará oculto para as ferramentas AX. Portanto, será ignorado pelas ferramentas AX."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu öğe AX araçlarından gizlenecektir. Bu nedenle AX araçları tarafından göz ardı edilecektir."
          }
        }
      }
    },
