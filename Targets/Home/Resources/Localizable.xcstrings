    "voiceover_instruction_text": {
      "comment": "UI Element: Text view.\nPurpose: Instructs the user to use VoiceOver to interact with the accessibility examples displayed on the screen.\nScreen/Context: Custom Accessibility Actions Screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Use **VoiceOver** to check below examples."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "নিচের উদাহরণগুলি পরীক্ষা করতে **ভয়েসওভার** ব্যবহার করুন।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "以下の例を確認するには、**VoiceOver** を使用してください。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwenden Sie **VoiceOver**, um die folgenden Beispiele zu überprüfen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez **VoiceOver** pour vérifier les exemples ci-dessous."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "नीचे दिए गए उदाहरणों की जाँच करने के लिए **वॉयसओवर** का उपयोग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa **VoiceOver** per controllare gli esempi seguenti."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa **VoiceOver** para revisar los ejemplos a continuación."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Använd **VoiceOver** för att kontrollera exemplen nedan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "استخدم **VoiceOver** للتحقق من الأمثلة أدناه."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "使用 **VoiceOver** 检查以下示例。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "아래 예시를 확인하려면 **VoiceOver**를 사용하세요."
          }
        },
        "nl": {
