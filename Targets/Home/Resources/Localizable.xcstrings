    "general_ax_modifiers_intro_text": {
      "comment": "Text view. Provides an introductory explanation about the purpose of the screen, which is to demonstrate various accessibility modifiers. Appears at the top of the 'General Accessibility Modifiers' screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "This screen demonstrates various accessibility modifiers and how they can be used to improve the accessibility of your app."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "এই স্ক্রিনটি বিভিন্ন অ্যাক্সেসিবিলিটি মডিফায়ার এবং কীভাবে সেগুলিকে আপনার অ্যাপের অ্যাক্সেসিবিলিটি উন্নত করতে ব্যবহার করা যেতে পারে তা প্রদর্শন করে।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "この画面では、さまざまなアクセシビリティ修飾子と、それらをアプリのアクセシビリティ向上にどのように使用できるかを示します。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Bildschirm demonstriert verschiedene Zugänglichkeitsmodifikatoren und wie sie verwendet werden können, um die Zugänglichkeit Ihrer App zu verbessern."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cet écran présente divers modificateurs d'accessibilité et comment ils peuvent être utilisés pour améliorer l'accessibilité de votre application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "यह स्क्रीन विभिन्न एक्सेसिबिलिटी मॉडिफ़ायर और उनका उपयोग आपके ऐप की एक्सेसिबिलिटी को बेहतर बनाने के लिए कैसे किया जा सकता है, यह दर्शाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa schermata dimostra vari modificatori di accessibilità e come possono essere utilizzati per migliorare l'accessibilità della tua app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta pantalla demuestra varios modificadores de accesibilidad y cómo se pueden usar para mejorar la accesibilità de su aplicación."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Denna skärm demonstrerar olika tillgänglighetsmodifierare och hur de kan användas för att förbättra tillgängligheten i din app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "تعرض هذه الشاشة معدّلات إمكانية الوصول المختلفة وكيف يمكن استخدامها لتحسين إمكانية الوصول لتطبيقك."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "此屏幕演示了各种辅助功能修饰符以及如何使用它们来提高应用程序的辅助功能。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "이 화면은 다양한 접근성 수정자와 이를 사용하여 앱의 접근성을 개선하는 방법을 보여줍니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dit scherm demonstreert verschillende toegankelijkheidsmodificatoren en hoe deze kunnen worden gebruikt om de toegankelijkheid van uw app te verbeteren."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "หน้าจอนี้สาธิตตัวปรับแต่งการเข้าถึงต่างๆ และวิธีที่สามารถนำมาใช้เพื่อปรับปรุงการเข้าถึงของแอปของคุณ"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Skrin ini menunjukkan pelbagai pengubah suai kebolehcapaian dan cara ia boleh digunakan untuk meningkatkan kebolehcapaian aplikasi anda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta tela demonstra vários modificadores de acessibilidade e como eles podem ser usados para melhorar a acessibilidade do seu aplicativo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bu ekran, çeşitli erişilebilirlik değiştiricilerini ve bunların uygulamanızın erişilebilirliğini geliştirmek için nasıl kullanılabileceğini göstermektedir."
          }
        }
      }
    },
