          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Auf Ihren Standort kann nicht zugegriffen werden. Bitte erlauben Sie den Standortzugriff."
          }
        },
        "fr": {
          "stringUnit": {
