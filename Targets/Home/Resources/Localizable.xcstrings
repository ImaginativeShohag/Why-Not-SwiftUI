    "location_access_denied_settings_message" : {
      "comment" : "This text is displayed in a warning banner on the map screen when the app has been denied location access. It informs the user that their location cannot be accessed and instructs them to enable it in the device settings.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن الوصول إلى موقعك. يرجى السماح بالوصول إلى الموقع في الإعدادات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার অবস্থান অ্যাক্সেস করা যাচ্ছে না। অনুগ্রহ করে সেটিংসে অবস্থানের অনুমতি দিন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Auf Ihren Standort kann nicht zugegriffen werden. Bitte erlauben Sie den Standortzugriff in den Einstellungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cannot access your location. Please allow location access in the settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se puede acceder a tu ubicación. Por favor, permite el acceso a la ubicación en los ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossible d'accéder à votre position. Veuillez autoriser l'accès à la position dans les réglages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके स्थान तक नहीं पहुँचा जा सकता। कृपया सेटिंग्स में स्थान पहुँच की अनुमति दें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Impossibile accedere alla tua posizione. Consenti l'accesso alla posizione nelle impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "現在地情報にアクセスできません。設定で位置情報へのアクセスを許可してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "위치에 액세스할 수 없습니다. 설정에서 위치 액세스를 허용해 주세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tidak dapat mengakses lokasi anda. Sila benarkan akses lokasi dalam tetapan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kan uw locatie niet openen. Sta locatietoegang toe in de instellingen."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Não é possível aceder à sua localização. Por favor, permita o acesso à localização nas definições."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kan inte komma åt din plats. Tillåt platstjänster i inställningarna."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ไม่สามารถเข้าถึงตำแหน่งของคุณได้ โปรดอนุญาตการเข้าถึงตำแหน่งในการตั้งค่า"
