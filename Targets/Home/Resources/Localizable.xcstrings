    "voiceover_instruction_text" : {
      "comment" : "UI Element: Text view.\nPurpose: Instructs the user to use VoiceOver to interact with the accessibility examples displayed on the screen.\nScreen/Context: Custom Accessibility Actions Screen.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدم **VoiceOver** للتحقق من الأمثلة أدناه."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "নিচের উদাহরণগুলি পরীক্ষা করতে **ভয়েসওভার** ব্যবহার করুন।"
          }
        },
        "de" : {
