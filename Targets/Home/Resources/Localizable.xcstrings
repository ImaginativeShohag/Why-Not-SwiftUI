    "location_service_instruction_text": {
      "comment": "Text label instructing the user to enable location services to view their current location on the map. Appears in the location authorization pre-alert screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Turn on location service to show your current location on the map."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "মানচিত্রে আপনার বর্তমান অবস্থান দেখাতে অবস্থান পরিষেবা চালু করুন।"
          }
        },
        "ja": {
          "stringUnit": {
