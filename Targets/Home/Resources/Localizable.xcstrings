    "shimmer_blocks_explanation" : {
      "comment" : "Text label. Explains how to use the ready-to-use shimmer blocks within the containers. Appears on the Shimmer UI Demo screen.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدم الكتل الجاهزة التالية داخل الحاويات المذكورة أعلاه لإضافة تأثير التلألؤ."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "উপরের কন্টেইনারগুলির ভিতরে শিমার প্রভাব যোগ করতে নিম্নলিখিত তৈরি-করা ব্লকগুলি ব্যবহার করুন।"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Verwenden Sie die folgenden vorgefertigten Blöcke innerhalb der oben genannten Container, um einen Schimmereffekt hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Use following ready-to-use blocks inside the above containers to add shimmer effect."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilice los siguientes bloques listos para usar dentro de los contenedores anteriores para añadir un efecto de brillo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez les blocs prêts à l'emploi suivants à l'intérieur des conteneurs ci-dessus pour ajouter un effet de scintillement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "शिमर प्रभाव जोड़ने के लिए उपरोक्त कंटेनरों के अंदर निम्नलिखित तैयार-उपयोग ब्लॉक का उपयोग करें।"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilizzare i seguenti blocchi pronti all'uso all'interno dei contenitori sopra per aggiungere un effetto luccicante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "上記のコンテナ内で以下の既製ブロックを使用して、シマー効果を追加します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "위 컨테이너 내에서 다음 기성 블록을 사용하여 쉬머 효과를 추가하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gunakan blok sedia ada berikut di dalam bekas di atas untuk menambah kesan kilauan."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
