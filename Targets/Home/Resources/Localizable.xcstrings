    "dynamic_type_layout_explanation": {
      "comment": "UI Element: Text. Purpose: Informs the user that the layout of the sample items will adapt based on the system's Dynamic Type setting. Screen/Context: Appears on the DynamicTypeScreen within the DynamicLayout view, demonstrating adaptive layouts.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The layout will be changed based on the `Dynamic Type`."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "লেআউটটি `ডাইনামিক টাইপ`-এর উপর ভিত্তি করে পরিবর্তিত হবে।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "レイアウトは`ダイナミックタイプ`に基づいて変更されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Layout wird basierend auf dem `Dynamischen Typ` geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La mise en page sera modifiée en fonction du `Type Dynamique`."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लेआउट `डायनामिक टाइप` के आधार पर बदल जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il layout verrà modificato in base al `Tipo Dinamico`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El diseño se cambiará según el `Tipo Dinámico`."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Layouten kommer att ändras baserat på `Dynamisk Typ`."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيتم تغيير التخطيط بناءً على `النوع الديناميكي`."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "布局将根据`动态类型`进行更改。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "레이아웃은 `동적 유형`에 따라 변경됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De lay-out wordt gewijzigd op basis van het `Dynamische Type`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เค้าโครงจะถูกเปลี่ยนตาม `Dynamic Type`"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Susun atur akan diubah berdasarkan `Jenis Dinamik`."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O layout será alterado com base no `Tipo Dinâmico`."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Düzen, `Dinamik Tip`'e göre değiştirilecektir."
          }
        }
      }
    },
    "dynamic_type_description": {
      "comment": "This Text view informs the user that the UI's layout, text, and padding will adapt based on the system's Dynamic Type setting. It appears on the Dynamic Type demonstration screen within the DynamicLayoutWithScaleMetric example.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "needs_review",
            "value": "The layout, text and paddings will be changed based on the `Dynamic Type`."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "needs_review",
            "value": "লেআউট, টেক্সট এবং প্যাডিং `ডাইনামিক টাইপ`-এর উপর ভিত্তি করে পরিবর্তিত হবে।"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "レイアウト、テキスト、パディングは「ダイナミックタイプ」に基づいて変更されます。"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das Layout, der Text und die Abstände werden basierend auf dem `Dynamischen Typ` geändert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La mise en page, le texte et les espacements seront modifiés en fonction du `Type Dynamique`."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "needs_review",
            "value": "लेआउट, टेक्स्ट और पैडिंग `डायनामिक टाइप` के आधार पर बदल जाएंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il layout, il testo e le spaziatura verranno modificati in base al `Tipo Dinamico`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "El diseño, el texto y los rellenos se cambiarán según el `Tipo Dinámico`."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Layouten, texten och utfyllnaden kommer att ändras baserat på `Dynamisk Typ`."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "needs_review",
            "value": "سيتم تغيير التخطيط والنص والحشوات بناءً على `النوع الديناميكي`."
          }
        },
        "zh": {
          "stringUnit": {
            "state": "needs_review",
            "value": "布局、文本和填充将根据“动态类型”进行更改。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "needs_review",
            "value": "레이아웃, 텍스트 및 패딩은 `동적 유형`에 따라 변경됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "needs_review",
            "value": "De lay-out, tekst en opvulling worden gewijzigd op basis van het `Dynamische Type`."
          }
        },
        "th": {
          "stringUnit": {
            "state": "needs_review",
            "value": "เค้าโครง ข้อความ และระยะห่างจะถูกเปลี่ยนแปลงตาม `ประเภทไดนามิก`"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Susun atur, teks dan pelapik akan diubah berdasarkan `Jenis Dinamik`."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "needs_review",
            "value": "O layout, o texto e os preenchimentos serão alterados com base no `Tipo Dinâmico`."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Düzen, metin ve dolgular `Dinamik Tip`'e göre değiştirilecektir."
          }
        }
      }
    },
